# === LLM (ZhiPu GLM) ===
LLM_API_KEY=your_glm_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2

# === LLM 备用端点（可选，三个都填才生效）===
# 出稿前会按 primary -> fallback 顺序探活，选中第一个能出字的端点。
# 典型用途：主端点是公司内网 one-api，GitHub runner 到不了，就靠备用端点兜住。
# GitHub Actions 里备用端点可直接用 GitHub Models，密钥就是 GITHUB_TOKEN：
#   LLM_FALLBACK_BASE_URL=https://models.inference.ai.azure.com
#   LLM_FALLBACK_API_KEY=$GITHUB_TOKEN
#   LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=

# === WeChat Official Account ===
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# === GitHub (for Actions) ===
# No secrets needed locally; set these as GitHub repo secrets for CI

# === Pipeline Options ===
LOOKBACK_HOURS=24
MAX_ITEMS=35
MIN_ITEMS=25
DIGEST_LANG=zh
ENABLE_HN=1
ENABLE_ARXIV=1
ENABLE_RSS=1
ENABLE_WEB=1
ENABLE_WECHAT_PUBLISH=0
DISABLE_AUDIO=1

# === Optional: Hacker News ===
HN_TOP_N=15

# === Optional: arXiv ===
ARXIV_MAX_PAPERS=10
