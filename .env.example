# === LLM (ZhiPu GLM) ===
LLM_API_KEY=your_glm_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2

# === WeChat Official Account ===
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# === GitHub (for Actions) ===
# No secrets needed locally; set these as GitHub repo secrets for CI

# === Pipeline Options ===
LOOKBACK_HOURS=24
MAX_ITEMS=35
MIN_ITEMS=25
DIGEST_LANG=zh
ENABLE_HN=1
ENABLE_ARXIV=1
ENABLE_RSS=1
ENABLE_WEB=1
ENABLE_WECHAT_PUBLISH=0
DISABLE_AUDIO=1

# === Optional: Hacker News ===
HN_TOP_N=15

# === Optional: arXiv ===
ARXIV_MAX_PAPERS=10
